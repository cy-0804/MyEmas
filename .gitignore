# Environment Variables & Secrets
.env
.env.*
!.env.example

# Android local machine config (contains local SDK/NDK paths)
android/local.properties
local.properties

# Android signing keystores (NEVER commit private keys)
*.jks
*.keystore
android/key.properties
key.properties

# Node / npm
node_modules/
npm-debug.log*

# Firebase
.firebase/
